{
  "$schema": "https://docs.renovatebot.com/renovate-schema.json",
  "extends": [
    "config:base"
  ],
  "packageRules": [
    {
      "matchUpdateTypes": ["minor", "patch"],
      "automerge": true
    },
    {
      "matchUpdateTypes": ["major"],
      "automerge": false
    }
  ],
  "gradle": {
    "enabled": true
  },
  "labels": ["dependencies"],
  "prConcurrentLimit": 5,
  "schedule": ["before 8am on monday"]
}
